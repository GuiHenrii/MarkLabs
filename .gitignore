# MarkLabs Global Gitignore
# Ignore environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
**/.env*

# Ignore all markdown files (as requested)
*.md
**/*.md
!README.md

# Ignore dependencies
node_modules/
**/node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Secrets/Certificates
*.pem
*.key
*.cert
*.p12
*.pfx
